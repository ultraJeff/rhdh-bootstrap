# Template for RHDH Keycloak Realm Import
#
# To use:
# 1. Copy this file to rhdh-realm-import.yaml (it's gitignored)
# 2. Replace <RHDH_CLIENT_SECRET> with your actual client secret
# 3. Update redirectUris and webOrigins with your cluster domain
# 4. Ensure the secret matches KEYCLOAK_CLIENT_SECRET in:
#    cluster-configs/developer-hub/secrets/keycloak-secrets.yaml (base64 decoded)
# 5. Apply with: oc apply -f rhdh-realm-import.yaml
---
apiVersion: k8s.keycloak.org/v2alpha1
kind: KeycloakRealmImport
metadata:
  name: rhdh-realm
  namespace: keycloak
spec:
  keycloakCRName: keycloak
  realm:
    id: rhdh
    realm: rhdh
    displayName: "RHDH Realm"
    enabled: true
    sslRequired: external
    loginWithEmailAllowed: true
    duplicateEmailsAllowed: false
    users:
      - username: admin
        enabled: true
        email: admin@example.com
        firstName: Admin
        lastName: User
        credentials:
          - type: password
            value: admin
            temporary: false
        groups:
          - /rhdh-users
      - username: user1
        enabled: true
        email: user1@example.com
        firstName: User
        lastName: One
        credentials:
          - type: password
            value: user1
            temporary: false
        groups:
          - /rhdh-users
      - username: service-account-rhdh
        enabled: true
        serviceAccountClientId: rhdh
        clientRoles:
          realm-management:
            - view-users
            - query-groups
            - query-users
    groups:
      - name: rhdh-users
        path: /rhdh-users
    clients:
      - clientId: rhdh
        name: RHDH Client
        description: Red Hat Developer Hub OIDC Client
        enabled: true
        protocol: openid-connect
        publicClient: false
        standardFlowEnabled: true
        directAccessGrantsEnabled: true
        serviceAccountsEnabled: true
        # Must match KEYCLOAK_CLIENT_SECRET in keycloak-secrets.yaml (base64 decoded)
        secret: "<RHDH_CLIENT_SECRET>"
        redirectUris:
          - "https://backstage-developer-hub-rhdh.apps.<YOUR_CLUSTER_DOMAIN>/api/auth/oidc/handler/frame"
        webOrigins:
          - "https://backstage-developer-hub-rhdh.apps.<YOUR_CLUSTER_DOMAIN>"
        defaultClientScopes:
          - web-origins
          - acr
          - profile
          - roles
          - email
        optionalClientScopes:
          - address
          - phone
          - offline_access
          - microprofile-jwt
